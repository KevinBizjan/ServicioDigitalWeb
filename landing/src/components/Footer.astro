---
// Footer propio de la landing (no usa el de _base para no tocar las
// plantillas de clientes). Datos desde consts.ts.
import { AGENCIA, urlWhatsApp, MENSAJE_GENERAL } from "../consts";

const links = [
  { label: "Servicios", href: "#servicios" },
  { label: "Rubros", href: "#rubros" },
  { label: "Por qué nosotros", href: "#por-que-nosotros" },
  { label: "Contacto", href: "#contacto" },
];
---
<footer class="bg-primary text-secondary">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-lg font-bold">
        <span class="text-white">Sitio</span><span class="text-accent">Firme</span>
      </p>
      <p class="mt-1 text-sm opacity-80">{AGENCIA.slogan}</p>
    </div>

    <nav class="flex flex-wrap gap-4 text-sm">
      {links.map((link) => (
        <a href={link.href} class="opacity-90 transition hover:text-accent hover:opacity-100">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex gap-4">
      <a
        href={AGENCIA.instagramUrl || undefined}
        target={AGENCIA.instagramUrl ? "_blank" : undefined}
        rel={AGENCIA.instagramUrl ? "noopener noreferrer" : undefined}
        aria-label={AGENCIA.instagramUrl ? "Instagram" : "Instagram (próximamente)"}
        class:list={["transition", AGENCIA.instagramUrl ? "opacity-90 hover:text-accent hover:opacity-100" : "opacity-60 cursor-default"]}
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
      </a>
      <a
        href={urlWhatsApp(MENSAJE_GENERAL)}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="WhatsApp"
        class="opacity-90 transition hover:text-accent hover:opacity-100"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z" />
        </svg>
      </a>
    </div>
  </div>

  <div class="border-t border-secondary/15">
    <p class="mx-auto max-w-6xl px-6 py-4 text-center text-xs opacity-70">
      © 2025 SitioFirme · Corrientes, Capital
    </p>
  </div>
</footer>
