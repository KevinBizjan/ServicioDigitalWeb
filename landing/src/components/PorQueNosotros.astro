---
interface Item {
  titulo: string;
  descripcion: string;
}

const ITEMS: Item[] = [
  { titulo: "Somos de acá", descripcion: "Conocemos Corrientes y Resistencia, el mercado local y cómo piensan los clientes de la zona." },
  { titulo: "Entrega en 48hs", descripcion: "Sin esperas eternas: tu primera versión en dos días." },
  { titulo: "Todo incluido", descripcion: "Dominio, hosting y soporte, sin sorpresas después." },
  { titulo: "Sin tecnicismos", descripcion: "Te explicamos todo simple, en palabras de tu negocio." },
];
---
<section id="por-que-nosotros" class="bg-secondary py-20">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-center text-3xl font-bold text-primary sm:text-4xl">
      Por qué elegirnos
    </h2>

    <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {ITEMS.map((item, i) => (
        <div class="animate-on-scroll rounded-2xl border border-primary/10 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/10 text-accent">
            {i === 0 && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
            )}
            {i === 1 && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 2" />
              </svg>
            )}
            {i === 2 && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 8v13H3V8" />
                <path d="M1 3h22v5H1z" />
                <path d="M10 12h4" />
              </svg>
            )}
            {i === 3 && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                <path d="M9 10h6M9 13h4" />
              </svg>
            )}
          </span>
          <h3 class="mt-4 text-lg font-bold text-primary">{item.titulo}</h3>
          <p class="mt-2 text-sm text-text/70">{item.descripcion}</p>
        </div>
      ))}
    </div>
  </div>
</section>
