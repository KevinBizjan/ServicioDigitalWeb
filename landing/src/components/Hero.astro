---
import { urlWhatsApp, MENSAJE_GENERAL } from "../consts";

// Patrón de puntos blancos (circle r=1 cada 24px) como data URI SVG.
// Va en un overlay con opacity 0.05 para textura sutil sobre el gradiente.
const patron =
  "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='24'%20height='24'%3E%3Ccircle%20cx='2'%20cy='2'%20r='1'%20fill='white'/%3E%3C/svg%3E";
---
<section
  class="relative overflow-hidden text-white"
  style="background-image: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);"
>
  <div
    class="pointer-events-none absolute inset-0"
    style={`background-image: url("${patron}"); opacity: 0.05;`}
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto flex max-w-4xl flex-col items-center px-6 py-24 text-center sm:py-32">
    <span class="mb-6 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-sm text-white/80">
      Tu negocio, presente en internet
    </span>

    <h1 class="text-4xl font-extrabold leading-[1.15] tracking-tight text-white sm:text-5xl md:text-6xl">
      Tu negocio merece estar <span class="text-[#a5b4fc]">en internet</span>
    </h1>

    <p class="mt-6 max-w-2xl text-base font-light text-white/85 sm:text-lg">
      Diseñamos y desarrollamos sitios web para comercios y profesionales del
      NEA. Con base de datos, pagos online y soporte real. Vos te ocupás de tu
      negocio, nosotros de tu presencia digital.
    </p>

    <div class="mt-10 flex flex-col gap-4 sm:flex-row">
      <a
        href="#rubros"
        class="rounded-full px-8 py-3 text-center font-semibold text-white transition-all duration-300 hover:scale-[1.02]"
        style="background-image: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.4);"
      >
        Ver qué hacemos
      </a>
      <a
        href={urlWhatsApp(MENSAJE_GENERAL)}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-white/25 px-8 py-3 text-center font-semibold text-white transition hover:bg-white/10"
      >
        Consultar ahora
      </a>
    </div>
  </div>
</section>
