---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.tsx";
import Hero from "../components/Hero.astro";
import Metricas from "../components/Metricas.astro";
import Rubros from "../components/Rubros.tsx";
import Paquetes from "../components/Paquetes.tsx";
import PorQueNosotros from "../components/PorQueNosotros.astro";
import Proceso from "../components/Proceso.astro";
import Contacto from "../components/Contacto.tsx";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.tsx";
import { AGENCIA } from "../consts";
---
<Layout
  title="SitioFirme — Sitios web para comercios y profesionales del NEA"
  description={AGENCIA.descripcion}
>
  <Header client:load />
  <Hero />
  <Metricas />
  <Rubros client:visible />
  <Paquetes client:visible />
  <PorQueNosotros />
  <Proceso />
  <Contacto client:visible />
  <Footer />
  <WhatsAppFloat client:load />
</Layout>
