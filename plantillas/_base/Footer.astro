---
// Footer compartido. Props con defaults para que cualquier plantilla
// (o la landing, que lo usa sin props) siga compilando.
interface LinkNav {
  label: string;
  href: string;
}
interface Red {
  tipo: "facebook" | "instagram";
  href: string;
}
interface Props {
  nombre?: string;
  links?: LinkNav[];
  redes?: Red[];
}

const { nombre = "SitioFirme", links = [], redes = [] } = Astro.props;
const anio = new Date().getFullYear();
---
<footer class="bg-primary text-secondary">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-lg font-bold text-accent">{nombre}</p>
      <p class="mt-1 text-sm opacity-80">Desarrollado por SitioFirme</p>
    </div>

    {links.length > 0 && (
      <nav class="flex flex-wrap gap-4 text-sm">
        {links.map((link) => (
          <a href={link.href} class="opacity-90 transition hover:text-accent hover:opacity-100">
            {link.label}
          </a>
        ))}
      </nav>
    )}

    {redes.length > 0 && (
      <div class="flex gap-4">
        {redes.map((red) => {
          const label = red.tipo === "facebook" ? "Facebook" : "Instagram";
          // Enlace real solo si hay URL configurada. "#" o vacío = placeholder:
          // se muestra el ícono pero NO navega. Personalizable luego: poné la URL
          // real en el array `redes` de la plantilla cuando exista la cuenta.
          const esEnlace = !!red.href && red.href !== "#";
          return (
          <a
            href={esEnlace ? red.href : undefined}
            target={esEnlace ? "_blank" : undefined}
            rel={esEnlace ? "noopener noreferrer" : undefined}
            aria-label={esEnlace ? label : `${label} (próximamente)`}
            class:list={["transition", esEnlace ? "opacity-90 hover:text-accent hover:opacity-100" : "opacity-60 cursor-default"]}
          >
            {red.tipo === "facebook" ? (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M14 9h3l.5-3H14V4.5c0-.9.3-1.5 1.6-1.5H17V.3C16.7.2 15.8 0 14.7 0 12.3 0 11 1.4 11 4v2H8v3h3v9h3V9z" />
              </svg>
            ) : (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            )}
          </a>
          );
        })}
      </div>
    )}
  </div>

  <div class="border-t border-secondary/15">
    <p class="mx-auto max-w-6xl px-6 py-4 text-center text-xs opacity-70">
      © {anio} {nombre}. Todos los derechos reservados.
    </p>
  </div>
</footer>
