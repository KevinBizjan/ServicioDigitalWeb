---
import "../styles/global.css";
import SEOHead from "@sitio-firme/base/SEOHead.astro";
import { NEGOCIO } from "../consts";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---
<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      url={NEGOCIO.url}
      type="website"
      schemaType="Restaurant"
      businessName={NEGOCIO.nombre}
      phone={NEGOCIO.telefono}
      address={NEGOCIO.direccion}
      email={NEGOCIO.email}
    />
  </head>
  <body class="bg-secondary text-text">
    <slot />
  </body>
</html>
