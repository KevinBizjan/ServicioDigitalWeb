---
import { NEGOCIO, HORARIOS, urlWhatsApp, WHATSAPP_RESERVA } from "../consts";

const telHref = `tel:+${NEGOCIO.whatsapp}`;
const reservaHref = urlWhatsApp(WHATSAPP_RESERVA);
---
<section id="reservas" class="bg-secondary py-20">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-6 md:grid-cols-2">
    <!-- Info -->
    <div>
      <h2 class="text-3xl font-bold text-primary sm:text-4xl">Reservas</h2>
      <p class="mt-3 text-text/70">Asegurá tu mesa, sobre todo los fines de semana.</p>

      <h3 class="mt-8 text-sm font-semibold uppercase tracking-wide text-accent">Horarios</h3>
      <ul class="mt-2 space-y-1 text-text/90">
        {HORARIOS.map((h) => (
          <li class="flex justify-between gap-4 border-b border-text/10 py-2">
            <span class="font-medium">{h.dia}</span>
            <span class="text-text/70">{h.horario}</span>
          </li>
        ))}
      </ul>

      <h3 class="mt-8 text-sm font-semibold uppercase tracking-wide text-accent">Capacidad</h3>
      <p class="mt-1 text-text/90">Salón para hasta 80 personas.</p>

      <h3 class="mt-6 text-sm font-semibold uppercase tracking-wide text-accent">Reserva anticipada</h3>
      <p class="mt-1 text-text/90">
        Para grupos y eventos te pedimos reservar con anticipación así te
        preparamos la mejor mesa.
      </p>
    </div>

    <!-- CTA -->
    <div class="flex flex-col items-center justify-center gap-6 rounded-2xl bg-primary p-10 text-center text-secondary">
      <p class="text-xl font-semibold">¿Listo para tu mesa?</p>
      <a
        href={reservaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full rounded-full bg-accent px-8 py-4 text-lg font-semibold text-white shadow-lg transition hover:brightness-110"
      >
        Reservar por WhatsApp
      </a>
      <p class="text-sm opacity-80">o llamanos:</p>
      <a href={telHref} class="text-lg font-semibold text-accent transition hover:brightness-110">
        {NEGOCIO.telefono}
      </a>
    </div>
  </div>
</section>
