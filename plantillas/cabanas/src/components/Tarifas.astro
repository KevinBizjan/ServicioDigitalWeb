---
import { urlWhatsApp, mensajeReserva } from "../consts";

interface Temporada {
  nombre: string;
  precio: string;
  incluye: string[];
  destacada: boolean;
}

const temporadas: Temporada[] = [
  {
    nombre: "Baja",
    precio: "$35.000",
    incluye: ["Cabaña para 2 a 6 personas", "Pileta y parrilla cubierta", "WiFi y estacionamiento"],
    destacada: false,
  },
  {
    nombre: "Media",
    precio: "$55.000",
    incluye: ["Cabaña para 2 a 6 personas", "Pileta y parrilla cubierta", "Desayuno opcional"],
    destacada: false,
  },
  {
    nombre: "Alta",
    precio: "$80.000",
    incluye: ["Cabaña para 2 a 6 personas", "Pileta y parrilla cubierta", "Desayuno opcional incluido"],
    destacada: true,
  },
];
---
<section id="tarifas" class="bg-secondary py-20">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-center text-3xl font-bold text-primary sm:text-4xl">Tarifas</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-text/70">
      Precios por noche según temporada.
    </p>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {temporadas.map((t) => (
        <article
          class:list={[
            "flex flex-col rounded-2xl bg-white p-8 shadow-sm",
            t.destacada ? "border-2 border-accent shadow-md" : "border border-text/10",
          ]}
        >
          {t.destacada && (
            <span class="mb-3 self-start rounded-full bg-accent px-3 py-1 text-xs font-semibold text-primary">
              Más elegida
            </span>
          )}
          <h3 class="text-xl font-bold text-primary">Temporada {t.nombre}</h3>
          <p class="mt-4">
            <span class="text-4xl font-bold text-primary">{t.precio}</span>
            <span class="text-text/60"> / noche</span>
          </p>

          <ul class="mt-6 flex-1 space-y-3 text-sm text-text/80">
            {t.incluye.map((item) => (
              <li class="flex items-start gap-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-accent" aria-hidden="true">
                  <path d="M5 12l5 5L20 7" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <a
            href={urlWhatsApp(mensajeReserva(t.nombre, t.precio))}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "mt-8 rounded-full px-6 py-3 text-center font-semibold transition",
              t.destacada
                ? "bg-accent text-primary hover:brightness-110"
                : "bg-primary text-secondary hover:brightness-125",
            ]}
          >
            Reservar por WhatsApp
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
