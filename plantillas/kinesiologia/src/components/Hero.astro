---
import { urlWhatsApp, WHATSAPP_CONSULTA } from "../consts";

const consultaHref = urlWhatsApp(WHATSAPP_CONSULTA);
---
<section id="inicio" class="relative flex min-h-screen items-center justify-center overflow-hidden">
  {/* Imagen de fondo como img absoluta para cumplir width/height/loading lazy */}
  <img
    src="https://images.unsplash.com/photo-1649751361457-01d3a696c7e6?w=1600&h=900&fit=crop&q=80"
    alt="Kinesiólogo examinando la pierna de un paciente en el consultorio"
    width="1600"
    height="900"
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover"
  />
  {/* Overlay diagonal en vez de plano: da profundidad sin tapar la foto */}
  <div class="absolute inset-0 bg-gradient-to-br from-primary/90 to-primary/65"></div>

  <div class="relative z-10 mx-auto max-w-3xl px-6 text-center text-secondary">
    {/* Acento de color con <span> sólido, NO background-clip:text:
        "Kinesiología" tiene una "g" descendente que el clip recortaría en Blink. */}
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
      Kinesiología <span style="color: #93c5fd;">Martínez</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg font-light opacity-85 sm:text-xl">
      Rehabilitación profesional en Resistencia. Turnos online disponibles.
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="#turnos"
        class="inline-block rounded-full bg-gradient-to-r from-accent to-blue-500 px-8 py-3 font-semibold text-white shadow-[0_10px_30px_-5px_rgba(37,99,235,0.4)] transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_14px_40px_-5px_rgba(37,99,235,0.55)]"
      >
        Sacar turno
      </a>
      <a
        href={consultaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded-full border-2 border-secondary px-8 py-3 font-semibold text-secondary transition hover:bg-secondary hover:text-primary"
      >
        Consultar por WhatsApp
      </a>
    </div>
  </div>
</section>
