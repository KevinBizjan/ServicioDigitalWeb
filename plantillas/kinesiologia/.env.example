# Copiá este archivo como .env.local y completá con tus credenciales de Supabase.
# La anon/publishable key es pública (se expone en el cliente); la seguridad
# real depende de las políticas RLS de la tabla (ver supabase-setup.sql).
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_TU_KEY
